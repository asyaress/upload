APP_PORT=3000

# Wajib: secret untuk session cookie (minimal 32 karakter acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
SESSION_MAX_AGE_HOURS=12

# Akun admin pertama (dibuat otomatis saat pertama kali jalan jika belum ada user)
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=password

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tesis_orders

REDIS_URL=redis://127.0.0.1:6379

# ID folder Google Drive induk untuk menyimpan semua order.
# Share folder ini ke service account email jika memakai service account.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# Pilih salah satu:
# 1. JSON service account dalam satu baris
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=

# 2. Atau path file JSON service account
GOOGLE_APPLICATION_CREDENTIALS=

MAX_ITEMS=50
# Batas ukuran per file. Default 5120 = 5 GB. Contoh: 3072 = 3 GB, 10240 = 10 GB
MAX_FILE_MB=5120

# Order processing lebih dari N menit dianggap macet dan di-requeue otomatis
STUCK_ORDER_MINUTES=15

# Folder penyimpanan sementara sebelum upload ke Drive
UPLOAD_DIR=storage/pending
