APP_PORT=3000

# Wajib: secret untuk session cookie (minimal 32 karakter acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
SESSION_MAX_AGE_HOURS=12

# Akun admin pertama (dibuat otomatis saat pertama kali jalan jika belum ada user)
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=password

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tesis_orders

REDIS_URL=redis://127.0.0.1:6379

# Google Drive OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production (live):
GOOGLE_OAUTH_REDIRECT_URI=https://upload-desain.toedjoesinargroup.com/oauth2/callback
# Local dev (opsional):
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3333/oauth2/callback
GOOGLE_REFRESH_TOKEN=

# ID folder Google Drive induk (milik akun Google yang sama dengan OAuth login)
GOOGLE_DRIVE_PARENT_FOLDER_ID=

MAX_ITEMS=50
MAX_FILE_MB=5120
STUCK_ORDER_MINUTES=15
UPLOAD_DIR=storage/pending

# OCR nota (gratis, self-hosted)
CUSTOMER_ANON_SALT=ganti-dengan-string-acak-untuk-hash-customer
OCR_TESSERACT_LANG=ind+eng
OCR_RENDER_SCALE=1.75
OCR_WORKER_CONCURRENCY=1
# Jika skor parse dari teks PDF di bawah nilai ini, coba ulang dengan Tesseract
OCR_PARSE_SCORE_FALLBACK=52
